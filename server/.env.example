# OfflineAI School production environment
NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://offlineai:change-me@localhost:5432/offlineai
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ALLOW_SELF_REGISTRATION=false
ALLOWED_ORIGINS=
TRUST_PROXY=false

# First organisation/school/admin seed
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=OfflineAI Administrator
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_ORGANIZATION_ID=
SEED_ORGANIZATION_NAME=
SEED_ORGANIZATION_TYPE=school_group
SEED_BILLING_EMAIL=
